autoload -Uz log_debug log_warning log_error

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ${+commands[ccache]} )) {
  log_debug "Found ccache at ${commands[ccache]}"

  typeset -gx CCACHE_CONFIGPATH="${project_root}/.ccache.conf"

  _ccache_set() {
    ccache --set-config="${1}" 2> /dev/null || log_debug "ccache option '${1%%=*}' not supported, skipping"
    return 0
  }

  _ccache_set run_second_cpp=true
  _ccache_set direct_mode=true
  _ccache_set inode_cache=true
  _ccache_set compiler_check=content
  _ccache_set file_clone=true

  local -a sloppiness=(
    include_file_mtime
    include_file_ctime
    file_stat_matches
    system_headers
  )

  if [[ ${host_os} == macos ]] {
    sloppiness+=(
      modules
      clang_index_store
    )

    _ccache_set sloppiness=${(j:,:)sloppiness}
  }

  if (( ${+CI} )) {
    _ccache_set cache_dir="${GITHUB_WORKSPACE:-${HOME}}/.ccache"
    _ccache_set max_size="${CCACHE_SIZE:-1G}"
    ccache -z > /dev/null
  }
} else {
  log_warning "No ccache found on the system"
}
